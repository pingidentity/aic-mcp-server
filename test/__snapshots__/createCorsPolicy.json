                        "value": 1,
                        "message": "Value cannot be empty"
                      }
                    ],
                    "typeName": "ZodString",
                    "coerce": false
                  },
                  "~standard": {
                    "version": 1,
                    "vendor": "zod"
                  }
                },
                "typeName": "ZodEffects",
                "effect": {
                  "type": "refinement"
                }
